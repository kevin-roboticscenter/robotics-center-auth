# Public Supabase values from the same project used by roboticscenter.ai.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-or-publishable-key>

# Comma-separated. Preview values are added only to the Vercel Preview scope.
AUTH_ALLOWED_RETURN_ORIGINS=https://<website-preview>.vercel.app
AUTH_ALLOWED_OAUTH_CLIENT_IDS=<website-preview-oauth-client-id>
AUTH_ALLOWED_OAUTH_REDIRECT_URIS=https://<website-preview>.vercel.app/auth/sso/callback
